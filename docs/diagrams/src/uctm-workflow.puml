@startuml
!include ../include/themes/light.puml
top to bottom direction
hide members

class "WorkflowDefinition" as WorkflowDefinition [[/concept/workflow/#ontology-facts]]
class "UseCase" as UseCase [[/concept/use-case/#ontology-facts]]
class "Story" as Story [[/concept/story/#ontology-facts]]
class "Outcome" as Outcome [[/concept/outcome/#ontology-facts]]
class "Concept" as Concept [[/concept/concept/#ontology-facts]]
class "StoryConceptRelationship" as StoryConceptRelationship [[/concept/concept/story-concept-relationship/#ontology-facts]]

' Other resources point to UseCase (typical KG modeling style)
WorkflowDefinition "0..*" --> "1" UseCase : :useCase

' Use Case Tree structure
UseCase "0..*" --> "0..1" UseCase : :isPartOf
UseCase "0..*" --> "0..*" UseCase : :isUsedIn

' Steps (relationship-object implied)
WorkflowDefinition --> Story : :steps

' Stories link to outcomes and concepts
Story --> Outcome : :contributesTo
Story "0..*" --> "1" StoryConceptRelationship : :storyConcept
StoryConceptRelationship --> Concept : :concept

@enduml

