@startuml
!include ../include/themes/light.puml
top to bottom direction
hide members
skinparam noteFontColor #333333

class "Corpus of Structured Knowledge\n<size:11>Observations • Facts • Corrections • Validations</size>" as Corpus

note right of Corpus : The Virtual\nEnterprise\nKnowledge Graph

class "Perpetual Learning Machine\n<size:11>Capture • Extract • Structure • Validate</size>" as PLM

class "Human Agents" as Human
class "GenAI Agents" as GenAI
class "System Agents" as System

class "Use Cases & Systems" as UseCases

PLM -up-> Corpus : Store
Corpus -down-> PLM : Retrieve
Human -up-> PLM
GenAI -up-> PLM
System -up-> PLM
Human -down-> UseCases
GenAI -down-> UseCases
System -down-> UseCases

@enduml
