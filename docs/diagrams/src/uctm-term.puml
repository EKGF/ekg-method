@startuml
!include ../include/themes/light.puml
top to bottom direction
hide members

class "ConceptManifestation" as ConceptManifestation [[/concept/term/#ontology]]
class "BusinessTerm" as BusinessTerm [[/concept/term/business-term/#ontology]]
class "TechnicalManifestation" as TechnicalManifestation [[/concept/term/technical-term/#ontology]]
class "DataElementConcept" as DataElementConcept [[/concept/concept/#ontology]]
class "ConceptSet" as ConceptSet [[/concept/concept/concept-vocabulary/#ontology]]
class "UseCase" as UseCase [[/concept/use-case/#ontology]]

' Manifestation specializations
ConceptManifestation <|-- BusinessTerm
ConceptManifestation <|-- TechnicalManifestation

' Ownership
DataElementConcept "1" *-- "0..*" ConceptManifestation : :hasManifestation
DataElementConcept "0..1" --> "1" BusinessTerm : :preferredBusinessTerm

' Shared concepts are grouped into sets used by use cases
DataElementConcept "0..*" --> "0..*" ConceptSet : ekg-concept:inConceptSet
UseCase "1" --> "0..*" ConceptSet : use-case:ownsConceptSet

' Use Case Tree structure
UseCase "0..*" --> "0..1" UseCase : :isPartOf
UseCase "0..*" --> "0..*" UseCase : :isUsedIn

@enduml
